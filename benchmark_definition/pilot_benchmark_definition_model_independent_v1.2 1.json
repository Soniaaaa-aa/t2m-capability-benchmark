{
  "benchmark_name": "T2M_Diagnostic_Benchmark_Pilot",
  "schema_version": "1.2-draft",
  "status": "pilot_validation_definition",
  "description": "Machine-readable, model-independent definition of the 96-prompt T2M diagnostic benchmark. Uses the team-revised 18-prompt Pilot selection, explicit requirement dependency metadata for evaluator routing, and an explicit difficulty-assignment definition. Motion generation length is determined by each source model rather than prescribed by this definition. Evaluator implementations and thresholds are not yet frozen.",
  "prompt_count": 18,
  "capabilities": {
    "C1": "Basic Action",
    "C2": "Spatial Control",
    "C3": "Attribute Control",
    "C4": "Event Structure",
    "C5": "Composition & Generalisation"
  },
  "difficulty_definition": {
    "principle": "Difficulty reflects overall instruction-execution complexity, not simply the number of atomic requirements.",
    "factors": [
      "event complexity",
      "control complexity",
      "temporal complexity",
      "relational complexity"
    ],
    "levels": {
      "Easy": "Single basic action with simple control and no complex event relationships.",
      "Medium": "Additional control demands or simple multi-event structure, such as body-side control, attributes, moderate counting, or two-event ordering.",
      "Hard": "Advanced execution demands such as higher counting, cross-body relations, simultaneity, or multi-action composition."
    },
    "note": "Atomic requirement count may contribute to complexity, but it does not determine difficulty by itself."
  },
  "evaluator_registry": {
    "action": "ActionEvaluator",
    "direction": "TrajectoryEvaluator",
    "torso_direction": "TorsoGeometryEvaluator",
    "body_side": "BodySideEvaluator",
    "arm_direction": "LimbGeometryEvaluator",
    "leg_direction": "LimbGeometryEvaluator",
    "turn_direction": "RotationEvaluator",
    "count": "CountEvaluator",
    "order": "OrderEvaluator",
    "attribute": "AttributeEvaluator",
    "simultaneous": "SimultaneousEvaluator",
    "relation": "SpatialRelationEvaluator",
    "target": "SpatialRelationEvaluator"
  },
