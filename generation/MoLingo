final = ROOT / "datasets" / "HumanML3D_272"
final.mkdir(parents=True, exist_ok=True)

need_dirs = ["mean_std", "motion_data", "split", "texts"]
if not all((final / n).exists() for n in need_dirs):
    snapshot_download(
        repo_id="lxxiao/272-dim-HumanML3D",
        repo_type="dataset",
        local_dir=str(raw),
        allow_patterns=["mean_std/*", "motion_data.zip", "split/*", "texts.zip"],
    )
    for zname in ["motion_data.zip", "texts.zip"]:
        hits = list(raw.rglob(zname))
        if not hits:
            print("missing", zname)
            continue
        with zipfile.ZipFile(hits[0]) as f:
            f.extractall(raw)
        print("unzipped", zname)

    # Promote known folders into the case-sensitive path eval/demo expect.
    search_roots = [raw, raw / "HumanML3D_272", ROOT / "datasets" / "humanml3d_272"]
    for folder in need_dirs:
        dest = final / folder
        if dest.exists():
            continue
        found = None
        for sr in search_roots:
            cand = sr / folder
            if cand.exists():
                found = cand
                break
            hits = [p for p in sr.rglob(folder) if p.is_dir() and p.name == folder]
            if hits:
                found = hits[0]
        if found is None:
            print("MISSING source for", folder)
            continue
        shutil.copytree(found, dest)
        print("placed", folder, "from", found)

print("272 layout:")
for n in need_dirs:
    p = final / n
    extra = ""
    if p.is_dir():
        extra = f" ({sum(1 for _ in p.glob('*'))} items)"
