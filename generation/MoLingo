def render_standard_grid(motion, title, output_path="/content/final_grid_skeleton.mp4", fps=30):
    motion = motion.copy().astype(np.float64)
    motion[:, :, 1] -= motion[:, :, 1].min()
    motion[:, :, 0] -= motion[0, 0, 0]
    motion[:, :, 2] -= motion[0, 0, 2]
    motion[:, :, 0] *= -1.0

    trajectory = motion[:, 0, :]
    x_min, x_max = -1.0, 2.5
    x_ticks = np.arange(-1.0, 2.5 + 0.001, 0.5)
    z_min, z_max = float(trajectory[:, 2].min()) - 1.0, float(trajectory[:, 2].max()) + 1.0
    if z_max - z_min < 3.0:
        centre = (z_min + z_max) / 2
        z_min, z_max = centre - 1.5, centre + 1.5
    y_min, y_max = 0.0, float(motion[:, :, 1].max()) + 0.25

    fig = plt.figure(figsize=(7, 7))
    ax = fig.add_subplot(111, projection="3d")
    GX, GZ = np.meshgrid(np.linspace(x_min, x_max, 10), np.linspace(z_min, z_max, 10))
    GY = np.zeros_like(GX)
    L = 0.8
    AXES = [
        ((L, 0, 0), "+X RIGHT"), ((-L, 0, 0), "-X LEFT"),
        ((0, L, 0), "+Z FORWARD"), ((0, -L, 0), "-Z BACKWARD"),
        ((0, 0, L), "+Y UP"),
    ]

    def update(frame):
        ax.cla()
        joints = motion[frame]
        for chain in t2m_kinematic_chain:
            p = joints[chain]
            ax.plot(p[:, 0], p[:, 2], p[:, 1], linewidth=3, color="#1f77b4")
        ax.scatter(joints[:, 0], joints[:, 2], joints[:, 1], s=20, color="#d62728")
        root_path = motion[: frame + 1, 0, :]
        ax.plot(root_path[:, 0], root_path[:, 2], np.zeros(len(root_path)),
                linestyle="--", linewidth=1.5, color="orange")
        ax.plot_wireframe(GX, GZ, GY, linewidth=0.3, alpha=0.35, color="grey")
        for (dx, dy, dz), label in AXES:
            ax.quiver(0, 0, 0, dx, dy, dz, arrow_length_ratio=0.12, color="purple", alpha=0.4)
            ax.text(dx, dy, dz, label, fontsize=8)
        ax.set_xlim(x_min, x_max)
        ax.set_xticks(x_ticks)
        ax.set_ylim(z_min, z_max)
