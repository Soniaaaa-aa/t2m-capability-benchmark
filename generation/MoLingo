def align_colab(motion: np.ndarray) -> np.ndarray:
    """Same alignment as the 3D grid renderer / Week 9 coordinate standard."""
    m = np.asarray(motion, dtype=np.float64).copy()
    if m.ndim == 4:
        m = m[0]
    if m.ndim != 3 or m.shape[1] < 22 or m.shape[2] != 3:
        raise ValueError(f"Need (F, 22, 3) joints, got {m.shape}")
    m[:, :, 1] -= m[:, :, 1].min()
    m[:, :, 0] -= m[0, 0, 0]
    m[:, :, 2] -= m[0, 0, 2]
    m[:, :, 0] *= -1.0
    return m


def smooth(x: np.ndarray, win: int = 5) -> np.ndarray:
    if len(x) < win:
        return x
    k = np.ones(win) / win
    return np.convolve(x, k, mode="same")


def unwrap(angles: np.ndarray) -> np.ndarray:
    return np.unwrap(angles)


def detect_jumps(root_y: np.ndarray, fps: float) -> list[float]:
    ys = smooth(root_y, 5)
    baseline = np.quantile(ys, 0.20)
    thresh = baseline + 0.16
    times: list[float] = []
    for i in range(2, len(ys) - 2):
        if ys[i] < thresh:
            continue
        if ys[i] >= ys[i - 1] and ys[i] >= ys[i + 1] and ys[i] >= ys[i - 2] and ys[i] >= ys[i + 2]:
            t = i / fps
            if not times or t - times[-1] > 0.45:
                times.append(t)
    return times


def body_yaw(frame: np.ndarray) -> float:
    """Hip + shoulder facing angle in XZ. θ = atan2(rightward.x, rightward.z) wait: facing."""
    hip_r = frame[R_HIP] - frame[L_HIP]
    sh_r = frame[R_SHOULDER] - frame[L_SHOULDER]
    right = hip_r + sh_r
    # Facing is perpendicular to the left→right vector in XZ: (+Z forward when +X is right)
    fx, fz = -right[2], right[0]
    return float(np.arctan2(fx, fz))


@dataclass
class Signals:
    frames: int
    duration: float
    dx: float
    dz: float
    early_dx: float
    early_dz: float
    mean_speed: float
    jump_times: list[float]
    jump_count: int
    dtheta_deg: float
    turn_time: float | None
    left_wrist_dy: float
    right_wrist_dy: float
    max_l_wrist_minus_head: float
    max_r_wrist_minus_head: float
    frames_l_above_head: int
    frames_r_above_head: int
    walk_raise_overlap: float


def extract_signals(motion: np.ndarray, fps: float = 30.0) -> Signals:
    m = align_colab(motion)
    f = len(m)
    dur = (f - 1) / fps if f > 1 else 0.0
    root = m[:, PELVIS]
    early = m[int((f - 1) * 0.38)] if f > 1 else m[0]
    speeds = []
    if f > 1:
        d = np.diff(root[:, [0, 2]], axis=0)
        speeds = list(np.linalg.norm(d, axis=1) * fps)

    yaws = unwrap(np.array([body_yaw(fr) for fr in m]))
    dtheta = float((yaws[-1] - yaws[0]) * 180.0 / np.pi)
    turn_t = None
    if f > 4:
        target = abs(yaws[-1] - yaws[0]) * 0.5
        for i, y in enumerate(yaws):
            if abs(y - yaws[0]) >= target:
                turn_t = i / fps
                break

    jumps = detect_jumps(root[:, 1], fps)

    lw = m[:, L_WRIST, 1]
    rw = m[:, R_WRIST, 1]
    head_y = m[:, HEAD, 1]
    l_above = int(np.sum(lw > head_y + 0.02))
    r_above = int(np.sum(rw > head_y + 0.02))

    horiz = np.linalg.norm(np.diff(root[:, [0, 2]], axis=0), axis=1) if f > 1 else np.array([])
    walking = np.zeros(f, dtype=bool)
    if len(horiz):
        walking[1:] = horiz * fps > 0.35
        walking[0] = walking[1]
    raising_r = rw > head_y - 0.05
    raising_r = raising_r & ((rw - rw[0]) > 0.15)
    overlap = float(np.mean(walking & raising_r)) if f else 0.0

    return Signals(
        frames=f,
        duration=dur,
        dx=float(root[-1, 0] - root[0, 0]),
        dz=float(root[-1, 2] - root[0, 2]),
        early_dx=float(early[PELVIS, 0] - root[0, 0]),
        early_dz=float(early[PELVIS, 2] - root[0, 2]),
        mean_speed=float(np.mean(speeds)) if speeds else 0.0,
        jump_times=jumps,
        jump_count=len(jumps),
        dtheta_deg=dtheta,
        turn_time=turn_t,
        left_wrist_dy=float(lw.max() - lw[0]),
        right_wrist_dy=float(rw.max() - rw[0]),
        max_l_wrist_minus_head=float((lw - head_y).max()),
        max_r_wrist_minus_head=float((rw - head_y).max()),
        frames_l_above_head=l_above,
        frames_r_above_head=r_above,
        walk_raise_overlap=overlap,
    )


def judge_direction(sig: Signals, want: str, has_turn: bool) -> tuple[str, str]:
    dx, dz = (sig.early_dx, sig.early_dz) if has_turn else (sig.dx, sig.dz)
    if want == "forward" and dz > 0.55 and abs(dz) > abs(dx) * 0.45:
        return "Pass", "forward"
    if want == "backward" and dz < -0.55 and abs(dz) > abs(dx) * 0.45:
        return "Pass", "backward"
    if want == "left" and dx < -0.7 and abs(dx) > abs(dz) * 0.45:
        return "Pass", "left"
    if want == "right" and dx > 0.7 and abs(dx) > abs(dz) * 0.45:
        return "Pass", "right"
    detected = "forward" if abs(dz) >= abs(dx) and dz >= 0 else "backward" if abs(dz) >= abs(dx) else "left" if dx < 0 else "right"
    return "Fail", detected


def judge_turn(sig: Signals) -> tuple[str, str]:
    # Δθ < 0 → Right after their convention. After our X-mirror,
    # a right turn faces +X, so heading change is typically positive.
    # Use both hip-shoulder Δθ sign toward +X and net +X displacement.
    to_plus_x = 35 < sig.dtheta_deg < 160 or -160 < sig.dtheta_deg < -35
    rightish = sig.dx > 0.35 or (35 < sig.dtheta_deg < 160)
    if rightish and to_plus_x:
        return "Pass", "right"
    if abs(sig.dtheta_deg) < 25:
        return "Fail", "none"
    return "Fail", "left" if sig.dtheta_deg < 0 and sig.dx < 0 else "unclear"


def judge_action(sig: Signals, expected: str) -> tuple[str, str]:
    parts = [p.strip() for p in expected.split(",")]
    seen = []
    ok = True
    if "walk" in parts:
        walking = sig.mean_speed > 0.28 and (abs(sig.dx) > 0.4 or abs(sig.dz) > 0.4)
        seen.append("walk" if walking else "no-walk")
        ok = ok and walking
    if "jump" in parts:
        seen.append(f"jump×{sig.jump_count}")
        ok = ok and sig.jump_count >= 1
    if "turn" in parts:
        turned = abs(sig.dtheta_deg) > 35
        seen.append("turn" if turned else "no-turn")
        ok = ok and turned
    if "raise hand" in parts:
        raised = max(sig.left_wrist_dy, sig.right_wrist_dy) > 0.25
        seen.append("raise" if raised else "no-raise")
        ok = ok and raised
    return ("Pass" if ok else "Fail"), ", ".join(seen)


def judge_order(sig: Signals, expected: str) -> tuple[str, str]:
    events: list[tuple[str, float]] = []
    if "walk" in expected:
        events.append(("walk", sig.duration * 0.15))
    for t in sig.jump_times:
        events.append(("jump", t))
    if "turn" in expected and sig.turn_time is not None:
        events.append(("turn", sig.turn_time))
    elif "turn" in expected:
        events.append(("turn", sig.duration * 0.75))
    wanted = [w.strip() for w in expected.replace("→", ">").split(">") if w.strip()]
    times = []
    for w in wanted:
        hits = [t for k, t in events if k == w]
        times.append(min(hits) if hits else None)
    obs = " → ".join(
        f"{w}@{times[i]:.2f}s" if times[i] is not None else f"{w}@?" for i, w in enumerate(wanted)
    )
    if any(t is None for t in times):
        return "Fail", obs
    for a, b in zip(times, times[1:]):
        if b + 0.12 < a:
            return "Fail", obs
    return "Pass", obs


def score_requirement(req: dict, sig: Signals, spec: dict, pair11: dict | None) -> dict:
    rtype, expected = req["type"], req["expected"]
    has_turn = any(r["type"] == "Turn Direction" for r in spec["requirements"])

    if rtype == "Action":
        label, det = judge_action(sig, str(expected))
    elif rtype == "Direction":
        label, det = judge_direction(sig, str(expected), has_turn)
    elif rtype == "Turn Direction":
        label, det = judge_turn(sig)
    elif rtype == "Attribute":
        if expected == "slow":
            label, det = ("Pass" if sig.mean_speed < 0.62 else "Fail"), f"{sig.mean_speed:.2f} m/s"
        elif expected == "fast":
            label, det = ("Pass" if sig.mean_speed > 1.15 else "Fail"), f"{sig.mean_speed:.2f} m/s"
        else:
            label, det = "Unclear", f"{sig.mean_speed:.2f} m/s"
    elif rtype == "Count":
        label = "Pass" if sig.jump_count == int(expected) else "Fail"
        det = str(sig.jump_count)
    elif rtype == "Body Side":
        side = "left" if sig.left_wrist_dy > sig.right_wrist_dy + 0.12 else (
            "right" if sig.right_wrist_dy > sig.left_wrist_dy + 0.12 else "unclear"
        )
        label = "Pass" if side == expected else ("Unclear" if side == "unclear" else "Fail")
        det = side
    elif rtype == "Arm Direction":
        wrist_head = (
            sig.max_l_wrist_minus_head if spec["id"] == 5 else sig.max_r_wrist_minus_head
        )
        frames = sig.frames_l_above_head if spec["id"] == 5 else sig.frames_r_above_head
        up = wrist_head > 0.05 or frames >= 8
        label = "Pass" if expected == "up" and up else "Fail"
        det = f"{'up' if up else 'not-up'} (wrist−head {wrist_head:+.3f} m, {frames} frames)"
    elif rtype == "Order":
        label, det = judge_order(sig, str(expected))
    elif rtype == "Simultaneous":
        label = "Pass" if sig.walk_raise_overlap > 0.12 else "Fail"
        det = f"overlap {sig.walk_raise_overlap:.2f}"
    elif rtype == "Paraphrase Pair":
        if pair11 is None:
            label, det = "Unclear", "prompt 11 missing"
        else:
            keys = ("Action", "Direction", "Turn Direction")
            a = {r["type"]: r["auto"] for r in pair11["requirements"] if r["type"] in keys}
            b = {r["type"]: r["auto"] for r in spec["requirements"] if r["type"] in keys}
            # compare after this req is scored — use direction/turn/action of current vs 11
            same = all(a.get(k) == b.get(k) for k in keys if k in a and k in b)
            label = "Pass" if same else "Fail"
            det = "consistent with #11" if same else "diverges from #11"
    else:
        label, det = "Unclear", "no rule"
    return {
        "type": rtype,
        "expected": expected,
        "auto": label,
        "detected": det,
        "human": "Pass / Fail / Unclear",
    }


def load_sample(anim: Path, sample_id: int) -> np.ndarray | None:
    for name in (
        f"molingo_sample{sample_id}_repeat0.npy",
        f"molingo_sample{sample_id - 1}_repeat0.npy",
    ):
        p = anim / name
        if p.exists():
            return np.load(p)
    return None


def evaluate(anim: Path, fps: float = 30.0) -> list[dict]:
    rows = []
    scored_11 = None
    for spec in WEEK9_PROMPTS:
        motion = load_sample(anim, spec["id"])
        if motion is None:
            rows.append({**spec, "missing": True, "requirements": [
                {**r, "auto": "Unclear", "detected": "npy missing", "human": "Pass / Fail / Unclear"}
                for r in spec["requirements"]
            ], "ara": None})
            continue
        sig = extract_signals(motion, fps=fps)
        req_out = []
        draft = {**spec, "requirements": []}
        for req in spec["requirements"]:
            if req["type"] == "Paraphrase Pair":
                continue
            item = score_requirement(req, sig, spec, None)
            req_out.append(item)
            draft["requirements"].append(item)
        for req in spec["requirements"]:
            if req["type"] != "Paraphrase Pair":
                continue
            req_out.append(score_requirement(req, sig, {**spec, "requirements": req_out}, scored_11))
        scorable = [r for r in req_out if r["auto"] != "Unclear"]
        passed = sum(1 for r in scorable if r["auto"] == "Pass")
        ara = passed / len(scorable) if scorable else None
        row = {
            **spec,
            "missing": False,
            "signals": asdict(sig),
            "requirements": req_out,
            "ara": ara,
            "file": f"molingo_sample{spec['id']}_repeat0.npy",
        }
        rows.append(row)
        if spec["id"] == 11:
            scored_11 = row
    return rows


def print_week9_tables(rows: list[dict]) -> None:
    print("\n=== Week 9 MoLingo automatic labels (human column still yours) ===\n")
    for row in rows:
        print(f"{row['capability']}  |  #{row['id']}  {row['prompt']}")
        if row.get("missing"):
            print("  npy missing — generate this prompt first\n")
            continue
        sig = row["signals"]
        print(
            f"  ΔX={sig['dx']:+.3f} m  ΔZ={sig['dz']:+.3f} m  "
            f"speed={sig['mean_speed']:.2f} m/s  jumps={sig['jump_count']}  "
            f"Δθ={sig['dtheta_deg']:+.1f}°  "
            f"LwΔY={sig['left_wrist_dy']:+.3f}  RwΔY={sig['right_wrist_dy']:+.3f}"
        )
        print(f"  {'Requirement':<16} {'Expected':<28} {'Auto':<8} Detected")
        for r in row["requirements"]:
            print(f"  {r['type']:<16} {str(r['expected']):<28} {r['auto']:<8} {r['detected']}")
        ara = row["ara"]
        print(f"  ARA = {ara:.1%}" if ara is not None else "  ARA = n/a")
        print()

    scorable = [r for row in rows for r in row["requirements"] if r["auto"] != "Unclear"]
    passed = sum(1 for r in scorable if r["auto"] == "Pass")
    print(f"Suite ARA (auto vs rules, Unclear excluded): {passed}/{len(scorable)}"
          + (f" = {passed / len(scorable):.1%}" if scorable else ""))
    print("Copy Auto into the MoLingo column. Replace with Human gold after you watch the mp4.")


def main() -> None:
    p = argparse.ArgumentParser()
    p.add_argument("--anim", type=Path, default=Path("/content/MoLingo/animation/dim_272_cfg_4.0_acc_1_step_32"))
    p.add_argument("--fps", type=float, default=30.0)
    p.add_argument("--json", type=Path, default=Path("/content/week9_molingo_ara.json"))
    args, _ = p.parse_known_args()  # ignore Jupyter/Colab -f kernel.json
    rows = evaluate(args.anim, fps=args.fps)
    print_week9_tables(rows)
    args.json.write_text(json.dumps(rows, indent=2, default=str))
    print("Wrote", args.json)


if __name__ == "__main__":
    main()

