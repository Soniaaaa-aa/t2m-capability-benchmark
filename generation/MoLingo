        ax.set_xlim(x_min, x_max)
        ax.set_xticks(x_ticks)
        ax.set_ylim(z_min, z_max)
        ax.set_zlim(y_min, y_max)
        ax.set_box_aspect((1, 1, 0.7))
        ax.view_init(elev=30, azim=-45)
        ax.set_xlabel("X (+Right/-Left)")
        ax.set_ylabel("Z (+Forward / -Backward)")
        ax.set_zlabel("Y (+Up)")
        ax.set_title(f"Sample {sample_number}: {title}\nFrame {frame + 1}/{len(motion)}", fontsize=10)

    ani = FuncAnimation(fig, update, frames=len(motion), interval=int(1000 / fps))
    ani.save(output_path, writer="pillow", fps=fps, dpi=100)
    plt.close(fig)
    return output_path


