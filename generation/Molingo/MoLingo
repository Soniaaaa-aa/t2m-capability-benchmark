        "UNZIP_CACHE_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "if output_dir.exists():\n",
        "    shutil.rmtree(output_dir)\n",
        "output_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# 📂 Extract your zip archive safely\n",
        "if not ZIP_SOURCE.exists():\n",
        "    raise FileNotFoundError(f\"Could not find your zip archive at: {ZIP_SOURCE}. Please verify the folder name.\")\n",
        "\n",
        "print(f\"📦 Unzipping source archive: {ZIP_SOURCE.name}...\")\n",
        "shutil.unpack_archive(str(ZIP_SOURCE), str(UNZIP_CACHE_DIR), \"zip\")\n",
        "print(f\"📂 Extracted files into: {UNZIP_CACHE_DIR}\")\n",
        "\n",
        "# =====================================================================\n",
        "# 2. Configuration & Parameter Mappings\n",
        "# =====================================================================\n",
        "TARGET_FRAME_COUNT = 100\n",
        "\n",
        "prompts_list = [\n",
        "    \"A person walks forward.\", \"A person walks backward.\", \"A person turns to the left.\",\n",
        "    \"A person walks to the right.\", \"A person walks to the left.\", \"A person turns to the right.\",\n",
        "    \"A person kicks the left leg out to the side.\", \"A person kicks the right leg out to the side.\",\n",
        "    \"A person moves the left hand across the body toward the right shoulder.\",\n",
        "    \"A person moves the right hand across the body toward the left shoulder.\",\n",
        "    \"A person walks slowly forward.\", \"A person walks quickly forward.\",\n",
        "    \"A person jumps once and then turns right.\", \"A person turns right and then jumps once.\",\n",
        "    \"A person jumps twice.\", \"A person jumps three times.\",\n",
        "    \"A person walks forward while raising the right hand.\",\n",
        "    \"A person turns right, walks forward, and then jumps once with both hands raised.\"\n",
        "]\n",
        "\n",
        "# Scan for extracted files (handles recursive folder structures inside the zip)\n",
        "all_npy_files = list(UNZIP_CACHE_DIR.glob(\"**/*.npy\"))\n",
        "print(f\"🔍 Found {len(all_npy_files)} numpy tracks inside the archive.\")\n",
        "\n",
        "# =====================================================================\n",
        "# 3. Processing & Standardization Loop\n",
        "# =====================================================================\n",
        "for target_npy_path in sorted(all_npy_files):\n",
        "    # Dynamically find the sample number from the filename (e.g. molingo_sample2_repeat0.npy -> 2)\n",
        "    match = re.search(r\"molingo_sample(\\d+)_\", target_npy_path.name)\n",
        "    if not match:\n",
        "        continue\n",
        "    sample_number = int(match.group(1))\n",
        "\n",
        "    prompt_id = f\"C1-{sample_number:02d}\"\n",
        "\n",
        "    # Load raw data safely\n",
        "    raw_motion_data = np.load(target_npy_path)\n",
        "    if raw_motion_data.ndim == 4:\n",
        "        raw_motion_data = np.squeeze(raw_motion_data, axis=0)\n",
        "\n",
        "    original_len = raw_motion_data.shape[0]\n",
        "    src_indices = np.linspace(0, original_len - 1, original_len)\n",
        "    tgt_indices = np.linspace(0, original_len - 1, TARGET_FRAME_COUNT)\n",
        "\n",
        "    # 📏 Mathematical Downsampling to 20 FPS (100 frames)\n",
        "    motion_data = np.zeros((TARGET_FRAME_COUNT, 22, 3), dtype=np.float32)\n",
        "    for joint_idx in range(22):\n",
        "        for axis_idx in range(3):\n",
        "            motion_data[:, joint_idx, axis_idx] = np.interp(\n",
        "                tgt_indices, src_indices, raw_motion_data[:, joint_idx, axis_idx]\n",
        "            )\n",
        "\n",
        "    # 🌍 BASE GEOMETRIC ALIGNMENT\n",
        "    motion_data = motion_data.astype(np.float64)\n",
        "    motion_data[:, :, 1] -= motion_data[:, :, 1].min()  # Floor plane snaps to Y=0\n",
        "    motion_data[:, :, 0] -= motion_data[0, 0, 0]        # Center X root\n",
        "    motion_data[:, :, 2] -= motion_data[0, 0, 2]        # Center Z root\n",
        "\n",
        "    # 🔧 THE ANTI-BLENDER CULPRIT PATCH\n",
        "    # Pre-invert the X-axis globally so it neutralizes your friend's mirror calculation\n",
        "    motion_data[:, :, 0] *= -1.0\n",
