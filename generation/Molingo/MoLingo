        "import os\n",
        "import shutil\n",
        "from base64 import b64encode\n",
        "from pathlib import Path\n",
        "import numpy as np\n",
        "from google.colab import drive\n",
        "from IPython.display import HTML, display\n",
        "\n",
        "# 1. Mount Google Drive securely\n",
        "drive.mount(\"/content/drive\")\n",
        "drive_dest_dir = Path(\"/content/drive/MyDrive/MoLingo_motion\")\n",
        "drive_dest_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# 2. Setup Source Path to your exact folder location\n",
        "anim_dir = Path(\"/content/MoLingo/animation/dim_272_cfg_4.0_acc_1_step_32\")\n",
        "\n",
        "if not anim_dir.exists():\n",
        "    raise FileNotFoundError(f\"❌ Cannot find the folder at: {anim_dir}\")\n",
        "\n",
        "# 3. Reference Blueprints (All 18 elements mapped to capability codes)\n",
        "SAMPLE_MAPPING = {\n",
        "    1: \"C1-01\", 2: \"C1-02\", 3: \"C1-06\", 4: \"C1-07\", 5: \"C2-01\", 6: \"C2-02\",\n",
        "    7: \"C2-09\", 8: \"C2-10\", 9: \"C2-19\", 10: \"C2-20\", 11: \"C3-01\", 12: \"C3-02\",\n",
        "    13: \"C4-01\", 14: \"C4-02\", 15: \"C4-09\", 16: \"C4-10\", 17: \"C4-19\", 18: \"C5-16\"\n",
        "}\n",
        "\n",
        "prompts_list = [\n",
        "    \"A person walks forward.\", \"A person walks backward.\", \"A person turns to the left.\",\n",
        "    \"A person walks to the right.\", \"A person walks to the left.\", \"A person turns to the right.\",\n",
        "    \"A person kicks the left leg out to the side.\", \"A person kicks the right leg out to the side.\",\n",
        "    \"A person moves the left hand across the body toward the right shoulder.\",\n",
        "    \"A person moves the right hand across the body toward the left shoulder.\",\n",
        "    \"A person walks slowly forward.\", \"A person walks quickly forward.\",\n",
        "    \"A person jumps once and then turns right.\", \"A person turns right and then jumps once.\",\n",
        "    \"A person jumps twice.\", \"A person jumps three times.\",\n",
        "    \"A person walks forward while raising the right hand.\",\n",
        "    \"A person turns right, walks forward, and then jumps once with both hands raised.\"\n",
        "]\n",
        "\n",
        "# Fallback basic stick figure renderer if standard layout is missing in environment\n",
        "def render_fallback_gif(motion_data, title_text, output_path):\n",
        "    import matplotlib.pyplot as plt\n",
        "    import matplotlib.animation as animation\n",
        "    fig = plt.figure(figsize=(4, 4))\n",
        "    ax = fig.add_subplot(111, projection='3d')\n",
        "    ax.set_xlim3d([-1, 1]); ax.set_ylim3d([-1, 1]); ax.set_zlim3d([-0.2, 1.8])\n",
        "    ax.set_title(title_text, fontsize=8)\n",
        "\n",
        "    # HumanML3D Standard Joint connections\n",
        "    SKELETON_BONES = [\n",
        "        (0, 1), (1, 4), (4, 7), (7, 10),                 # Right Leg\n",
        "        (0, 2), (2, 5), (5, 8), (8, 11),                 # Left Leg\n",
        "        (0, 3), (3, 6), (6, 9), (9, 12), (12, 15),       # Spine / Neck / Head\n",
        "        (9, 13), (13, 16), (16, 18), (18, 20),           # Left Arm\n",
        "        (9, 14), (14, 17), (17, 19), (19, 21)            # Right Arm\n",
        "    ]\n",
        "\n",
        "    lines = [ax.plot([], [], [], color='blue', linewidth=2)[0] for _ in SKELETON_BONES]\n",
        "\n",
        "    def update(frame):\n",
        "        frame_data = motion_data[frame]\n",
        "        for line, (joint_a, joint_b) in zip(lines, SKELETON_BONES):\n",
        "            if joint_a < frame_data.shape[0] and joint_b < frame_data.shape[0]:\n",
        "                x = [frame_data[joint_a, 0], frame_data[joint_b, 0]]\n",
        "                y = [frame_data[joint_a, 2], frame_data[joint_b, 2]]\n",
        "                z = [frame_data[joint_a, 1], frame_data[joint_b, 1]]\n",
        "                line.set_data(x, y)\n",
        "                line.set_3d_properties(z)\n",
        "        return lines\n",
        "\n",
        "    ani = animation.FuncAnimation(fig, update, frames=len(motion_data), interval=50, blit=True)\n",
        "    plt.close(fig)\n",
        "    ani.save(output_path, writer='pillow', fps=20)\n",
        "\n",
        "missing = []\n",
        "\n",
        "# 4. Loop across all 18 standard research elements directly inside the target directory\n",
        "for sample_number in range(1, 19):\n",
        "    target_prompt = prompts_list[sample_number - 1]\n",
        "    prompt_id = SAMPLE_MAPPING[sample_number]\n",
        "\n",
        "    npy_path = anim_dir / f\"{prompt_id}.npy\"\n",
        "    gif_path = anim_dir / f\"{prompt_id}.gif\"\n",
        "\n",
        "    print(f\"\\n=== Sample {sample_number}/18 ({prompt_id}): {target_prompt} ===\")\n",
        "\n",
        "    if not npy_path.exists():\n",
        "        print(f\"  SKIP — File target missing on memory disk: {npy_path.name}\")\n",
        "        missing.append(prompt_id)\n",
        "        continue\n",
        "\n",
        "    # Load matrix components cleanly\n",
        "    motion_data = np.load(npy_path)\n",
        "    if motion_data.ndim == 4:\n",
        "        motion_data = motion_data[0]\n",
        "\n",
        "    # Render pipeline checks\n",
        "    try:\n",
        "        if 'render_standard_grid' in globals():\n",
        "            render_standard_grid(motion_data, target_prompt, output_path=str(gif_path))\n",
        "        else:\n",
        "            render_fallback_gif(motion_data, target_prompt, str(gif_path))\n",
        "\n",
        "        # Synchronise data over to remote Google Drive directory paths\n",
        "        dest = drive_dest_dir / gif_path.name\n",
        "        shutil.copy2(gif_path, dest)\n",
        "\n",
        "        print(f\"  ✅ Wrote: {gif_path.name} ({gif_path.stat().st_size / 1024:.1f} KB)\")\n",
        "        print(f\"  📂 Mirrored to Drive path -> Size: {dest.stat().st_size / 1024:.1f} KB\")\n",
        "\n",
        "        # Stream interactive loop visualizer straight into console panel logs\n",
        "        encoded_gif = b64encode(open(gif_path, \"rb\").read()).decode()\n",
        "        display(HTML(\n",
        "            f\"<p><b>Sample {sample_number} [{prompt_id}]: {target_prompt}</b></p>\"\n",
        "            f'<img src=\"data:image/gif;base64,{encoded_gif}\" width=\"400\" />'\n",
        "        ))\n",
        "    except Exception as e:\n",
        "        print(f\"  ❌ Failed rendering phase: {e}\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"🏁 GRID GIFs synchronised on Drive:\", [f.name for f in drive_dest_dir.glob(\"*_GRID.gif\")])\n",
        "if missing:\n",
        "    print(\"⚠️ Still missing entries for target IDs:\", missing)\n"
      ]
    },
