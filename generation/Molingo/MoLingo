        "    # 🛠️ DYNAMIC CAPABILITY & DIFFICULTY ASSIGNMENT MATRIX\n",
        "    if 1 <= sample_number <= 6:\n",
        "        capability_flag, difficulty_flag = \"C1_Navigation\", \"Easy\"\n",
        "    elif 7 <= sample_number <= 8:\n",
        "        capability_flag, difficulty_flag = \"C2_Physical_Action\", \"Easy\"\n",
        "    elif 9 <= sample_number <= 10:\n",
        "        capability_flag, difficulty_flag = \"C3_Gesture\", \"Easy\"\n",
        "    elif 11 <= sample_number <= 12:\n",
        "        capability_flag, difficulty_flag = \"C4_Locomotion_Modifier\", \"Easy\"\n",
        "    elif 13 <= sample_number <= 16:\n",
        "        capability_flag, difficulty_flag = \"C5_Sequential_Action\", \"Medium\"\n",
        "    else:\n",
        "        capability_flag, difficulty_flag = \"C6_Compositional\", \"Hard\"\n",
        "\n",
        "    # Export fixed array matrix file\n",
        "    npy_export_path = output_dir / f\"{prompt_id}.npy\"\n",
        "    np.save(npy_export_path, motion_data.astype(np.float32))\n",
        "\n",
        "    # Export synchronized descriptor manifest JSON file\n",
        "    json_export_path = output_dir / f\"{prompt_id}.json\"\n",
        "    standardized_meta = {\n",
        "        \"model\": \"MoLingo\",\n",
        "        \"prompt_id\": prompt_id,\n",
        "        \"prompt\": prompts_list[sample_number - 1],\n",
        "        \"capability\": capability_flag,\n",
        "        \"difficulty\": difficulty_flag,\n",
        "        \"target_frames\": TARGET_FRAME_COUNT,\n",
        "        \"actual_frames\": TARGET_FRAME_COUNT,\n",
        "        \"fps\": 20,\n",
        "        \"shape\": list(motion_data.shape),\n",
        "        \"coordinate_system\": \"global_xyz\",\n",
        "        \"up_axis\": \"+Y\",\n",
        "        \"forward_axis\": \"+Z\",\n",
        "        \"right_axis\": \"+X\",\n",
        "        \"units\": \"metres\",\n",
        "        \"source_raw_npy\": str(target_npy_path.name),\n",
        "        \"benchmark_npy\": str(npy_export_path),\n",
        "        \"created_utc\": datetime.now(timezone.utc).isoformat()\n",
        "    }\n",
        "\n",
        "    with open(json_export_path, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(standardized_meta, f, indent=4, ensure_ascii=False)\n",
        "\n",
        "    print(f\" ✅ Processed and saved: {prompt_id} ({prompts_list[sample_number - 1]})\")\n",
        "\n",
        "# =====================================================================\n",
        "# 4. Packaging Archive & Final Download Trigger\n",
        "# =====================================================================\n",
        "zip_base_path = Path(\"/content/MoLingo_BlenderSafe_Outputs\")\n",
        "if zip_base_path.with_suffix(\".zip\").exists():\n",
        "    zip_base_path.with_suffix(\".zip\").unlink()\n",
        "\n",
        "shutil.make_archive(str(zip_base_path), \"zip\", output_dir, \".\")\n",
        "print(f\"\\n📦 Compression complete. Downloading package: {zip_base_path.with_suffix('.zip')}\")\n",
        "\n",
        "# Clean up raw unzip cache directory to keep space free\n",
        "shutil.rmtree(UNZIP_CACHE_DIR, ignore_errors=True)\n",
        "\n",
        "# Save directly to local hard drive\n",
        "files.download(str(zip_base_path.with_suffix(\".zip\")))\n"
